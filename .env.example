# Copy this file to .env and add local configuration values as needed.
# Never commit .env or credentials.

# The absolute host path mounted at /data in the NAS container.
FRAME_ART_DATA_DIR=/srv/your-primary-volume/Art/frame-art

# Leave blank until the Frame is physically installed and has a reserved LAN IP.
FRAME_ART_TV_HOST=

# Keep localhost for nginx. Use the NAS tailnet IP only for the temporary
# direct-access deployment while nginx administrator access is unavailable.
FRAME_ART_BIND_ADDRESS=127.0.0.1
